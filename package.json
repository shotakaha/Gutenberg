{
  "name": "gutenberg-css",
  "version": "0.8.2",
  "description": "Print your web pages with style",
  "main": "scss/gutenberg.scss",
  "browser": "dist/gutenberg.min.css",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint": "stylelint \"scss/**/*.scss\"",
    "test": "npm run lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.scss": "stylelint --fix"
  },
  "keywords": [
    "framework",
    "css",
    "print",
    "eyeglass-module"
  ],
  "author": "Fabien Sa",
  "contributors": [
    "qumasan (maintainer of this fork)"
  ],
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/shotakaha/Gutenberg.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/shotakaha/Gutenberg/issues"
  },
  "homepage": "https://github.com/shotakaha/Gutenberg#readme",
  "dependencies": {
    "normalize.css": "^8.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "sass": "1.58.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
