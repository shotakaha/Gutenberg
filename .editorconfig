root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[{*.css,*.sass,*.scss,*.html}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# YAML forbids tabs; be explicit.
[*.yml]
indent_style = space

# Binary / vendored / generated — leave exactly as-is.
[*.png]
trim_trailing_whitespace = false
insert_final_newline = false

[LICENSE]
insert_final_newline = false

[.husky/*]
trim_trailing_whitespace = false
insert_final_newline = false
